{
	"name": "@tanstack-start-portfolio/infra",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./alchemy.run": "./alchemy.run.ts"
	},
	"scripts": {
		"dev": "alchemy dev",
		"deploy": "node --import ./node-fetch-compat.mjs alchemy.run.ts --stage dev",
		"destroy": "node --import ./node-fetch-compat.mjs alchemy.run.ts --destroy --stage dev",
		"typecheck": "tsc --noEmit",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"dotenv": "^17.2.2",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@tanstack-start-portfolio/config": "*",
		"alchemy": "^0.91.2",
		"typescript": "^6.0.3"
	}
}

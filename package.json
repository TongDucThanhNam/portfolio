{
	"name": "tanstack-start-portfolio",
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo run dev",
		"dev:web": "turbo run dev -F web",
		"build": "turbo run build",
		"preview": "turbo run preview -F web",
		"start": "npm run preview --workspace web",
		"typecheck": "turbo run typecheck",
		"check-types": "turbo run check-types",
		"lint": "turbo run lint",
		"check:tailwind-only": "node scripts/check-tailwind-only.mjs",
		"generate:ascii-portrait": "node scripts/generate-ascii-portrait.mjs",
		"db:generate": "turbo run db:generate -F @tanstack-start-portfolio/db",
		"deploy": "turbo run deploy -F @tanstack-start-portfolio/infra",
		"destroy": "turbo run destroy -F @tanstack-start-portfolio/infra",
		"check": "biome check --write ."
	},
	"author": {
		"name": "Tong Duc Thanh Nam",
		"email": "tongducthanhnam@gmail.com"
	},
	"keywords": [
		"tanstack-start",
		"cloudflare",
		"alchemy",
		"d1",
		"react",
		"tailwindcss",
		"portfolio"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@cloudflare/workers-types": "^4.20260621.1",
		"@types/node": "^22.13.14",
		"drizzle-orm": "^0.45.2",
		"sharp": "^0.34.5",
		"turbo": "2.9.16",
		"typescript": "^6.0.3"
	},
	"packageManager": "npm@11.16.0"
}
